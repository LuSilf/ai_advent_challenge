OPENAI_API_KEY_ENV=OPENAI_API_KEY
OPENAI_MODEL=llama3.2:3b
# Default base URL points to local Ollama (chat.completions compatible).
# Override for OpenRouter: https://openrouter.ai/api/v1
# Override for OpenAI:     https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
# Optional: system instruction
# OPENAI_SYSTEM_PROMPT=You are a poetic assistant in Russian
# Optional: set key directly instead of indirection (Ollama accepts any non-empty value)
# OPENAI_API_KEY=ollama
# Optional: request timeout in milliseconds (default 30000)
# OPENAI_TIMEOUT_MS=30000
# Optional: stream response tokens (default enabled)
# Supported values: 1|0|true|false|yes|no|on|off
# OPENAI_STREAM=1
# Optional: debug logs
# Supported values: 1|0|true|false|yes|no|on|off
# OPENAI_DEBUG=1

# Optional: temperature 0..2 (higher = more random)
# OPENAI_TEMPERATURE=0.7
# Optional: nucleus sampling 0..1
# OPENAI_TOP_P=1
# Optional: number of choices to generate (integer >= 1)
# Not wired through the current request builder
# OPENAI_N=1
# Optional: max generated tokens (integer >= 1)
# OPENAI_MAX_COMPLETION_TOKENS=1024
# Optional: novelty penalty -2..2
# Not wired through the current request builder
# OPENAI_PRESENCE_PENALTY=0
# Optional: repetition penalty -2..2
# Not wired through the current request builder
# OPENAI_FREQUENCY_PENALTY=0

# --- Telegram bot (bun run bot) ---
# Required. Bot token from @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Required. Comma-separated chat_id whitelist. Non-listed chats get a polite refusal.
# TELEGRAM_ALLOWED_CHAT_IDS=12345678,-10098765
# Optional. Ollama model tag (default qwen3:4b-instruct-2507-q4_K_M).
# Qwen3-4B-Instruct — Perfect fit for 4GB VRAM (llmfit verdict), strong Russian,
# ~20–30 tok/s on GTX 1650 class hardware. llama3.2:3b is faster but weaker on Russian.
# TELEGRAM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Optional. LLM endpoint for the bot (default http://localhost:11434/v1).
# Intentionally separate from OPENAI_BASE_URL — the REPL can point at cloud
# while the bot stays local-only.
# TELEGRAM_BASE_URL=http://localhost:11434/v1
# Optional. Timeout for a single inference request in ms (default 180000).
# TELEGRAM_TIMEOUT_MS=180000
# Optional. Hard cap on completion length (default 768 tokens).
# TELEGRAM_MAX_TOKENS=768
# Optional. System prompt. Default asks for brevity in Russian, <= ~300 words.
# TELEGRAM_SYSTEM_PROMPT=You are a concise assistant. Keep answers short.

# --- Day 28: local RAG vs cloud RAG batch eval (bun run scripts/day28/run-eval.ts) ---
# Retrieval, reranker, query rewriter, local generator — all on local Ollama.
# Cloud side goes through OPENAI_API_KEY / OPENAI_BASE_URL (same as the REPL).
# Judge is dual: cloud (OPENAI_API_KEY) + local (DAY28_LOCAL_MODEL).

# Ollama host used for embedder, reranker, rewriter, local generator,
# and local judge. Default http://localhost:11434 (no /v1 suffix — script adds it).
# DAY28_LOCAL_OLLAMA_URL=http://localhost:11434
# Local model tag. Must be pulled into Ollama first (ollama pull <name>).
# Default: qwen3:4b-instruct-2507-q4_K_M (already used by the Telegram bot).
# DAY28_LOCAL_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Cloud model id. If unset, falls back to modelRepo.getRole('chat') or 'openai/gpt-5-nano'.
# DAY28_CLOUD_MODEL=openai/gpt-5-nano
# Cloud judge model (defaults to DAY28_CLOUD_MODEL).
# DAY28_CLOUD_JUDGE_MODEL=openai/gpt-5-nano
# Runs per (question × mode × backend) pair for stability measurement. Default 3.
# DAY28_RUNS=3
# Sampling temperature, [0, 2]. Default 0.2.
# DAY28_TEMPERATURE=0.2
# RAG strategy: structural | fixed. Must match an index that was built earlier.
# DAY28_STRATEGY=structural
# Distance threshold for rag-threshold / rag-reranker / rag-full modes.
# DAY28_THRESHOLD=0.85
# Max completion tokens for LOCAL generator (4B model is fast enough with a large cap).
# DAY28_MAX_TOKENS=800
# Max completion tokens for CLOUD generator. Higher than local because reasoning models
# (gpt-5-nano) eat a big chunk on reasoning tokens before emitting content.
# DAY28_CLOUD_MAX_TOKENS=4000
# Cloud request timeout in ms. Default 180000 (3 min). Higher than the REPL's
# OPENAI_TIMEOUT_MS because reasoning-mode responses can be slow.
# DAY28_CLOUD_TIMEOUT_MS=180000

# --- Day 30: local LLM HTTP service (bun run server) ---
# Listening host (default 0.0.0.0). Use 127.0.0.1 to keep service strictly localhost.
# LLM_SERVICE_HOST=0.0.0.0
# Listening port (default 8080).
# LLM_SERVICE_PORT=8080
# Upstream Ollama URL (default http://localhost:11434, no /v1 suffix — proxy adds it).
# OLLAMA_BASE_URL=http://localhost:11434
# Per-request upstream timeout in ms (default 180000).
# LLM_SERVICE_TIMEOUT_MS=180000
# Required. Bearer API keys, format: keyId:secret,keyId:secret. The keyId is used
# for rate-limit bucketing and access logs; secret is the value clients send in
# `Authorization: Bearer <secret>`. Use a long random string for each secret.
# LLM_SERVICE_API_KEYS=personal:sk-changeme
# Allowlist of Ollama model tags this service is willing to proxy (CSV).
# Default: llama3.2:3b,qwen2.5-coder:7b
# LLM_SERVICE_ALLOWED_MODELS=llama3.2:3b,qwen2.5-coder:7b
# Rate-limit per API key, token bucket. capacity = burst, refill = sustained RPS.
# Defaults: 10 / 1.
# LLM_SERVICE_RATE_CAPACITY=10
# LLM_SERVICE_RATE_REFILL_PER_SEC=1
# Hard cap on input tokens (system + history + user message). Counted via gpt-tokenizer
# (cl100k_base, ~OpenAI heuristic). Default 6000 keeps room for output within 8k context.
# Requests above limit get HTTP 413.
# LLM_SERVICE_MAX_INPUT_TOKENS=6000
